{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "fir_version": "1.0.0",
  "name": "WF_001_SPECTRAL_TRIAGE",
  "telos": "Telemetric Spectral Triage & State Machine Workflow",
  "initial_state": "STATE_0_ACUTE_HEMOSTASIS",
  "states": [
    "STATE_0_ACUTE_HEMOSTASIS",
    "STATE_1_ONTOLOGICAL_GROUNDING",
    "STATE_2_SPECTRAL_NOISE_FILTERING",
    "STATE_3_3_TIER_DECOMPOSITION",
    "STATE_4_FIR_COMPILATION",
    "STATE_5_ADVERSARIAL_CRUCIBLE",
    "READY_FOR_DISPATCH"
  ],
  "action_transition_matrix": [
    {
      "from": "STATE_0_ACUTE_HEMOSTASIS",
      "event": "CRASH_OR_EXHAUSTION_RESOLVED",
      "to": "STATE_1_ONTOLOGICAL_GROUNDING",
      "pre_conditions": ["system_stable == true"],
      "post_conditions": ["active_stabilizer == true"]
    },
    {
      "from": "STATE_1_ONTOLOGICAL_GROUNDING",
      "event": "TELOS_VALIDATED",
      "to": "STATE_2_SPECTRAL_NOISE_FILTERING",
      "pre_conditions": ["telos_defined == true"],
      "post_conditions": ["defect_classified == true"]
    },
    {
      "from": "STATE_2_SPECTRAL_NOISE_FILTERING",
      "event": "NOISE_ATTENUATED",
      "to": "STATE_3_3_TIER_DECOMPOSITION",
      "pre_conditions": ["subjective_adjectives_purged == true"],
      "post_conditions": ["harmonic_isolated == true"]
    },
    {
      "from": "STATE_3_3_TIER_DECOMPOSITION",
      "event": "HIERARCHY_FORMULATED",
      "to": "STATE_4_FIR_COMPILATION",
      "pre_conditions": ["3_tier_structure_present == true"],
      "post_conditions": ["blast_radius_isolated == true"]
    },
    {
      "from": "STATE_4_FIR_COMPILATION",
      "event": "FIR_SCHEMA_COMPILED",
      "to": "STATE_5_ADVERSARIAL_CRUCIBLE",
      "pre_conditions": ["state_transition_matrix_complete == true"],
      "post_conditions": ["fir_valid == true"]
    },
    {
      "from": "STATE_5_ADVERSARIAL_CRUCIBLE",
      "event": "CENTENNIAL_MUTATIONS_SURVIVED",
      "to": "READY_FOR_DISPATCH",
      "pre_conditions": ["mutation_pass_rate == 1.0", "latency_ms <= 500"],
      "post_conditions": ["certified_for_dispatch == true"]
    }
  ],
  "invariant_verification_set": [
    "INV-FORMAL-IR-GATE",
    "INV-RUNTIME-INTERCEPT",
    "INV-CRUCIBLE-CERTIFICATION"
  ]
}
